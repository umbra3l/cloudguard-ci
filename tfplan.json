{
  "format_version": "1.0",
  "resource_changes": [
    {
      "address": "aws_s3_bucket.safe_bucket",
      "type": "aws_s3_bucket",
      "change": {
        "after": {
          "bucket": "company-private-data",
          "acl": "private"
        }
      }
    },
    {
      "address": "aws_s3_bucket.vulnerable_bucket",
      "type": "aws_s3_bucket",
      "change": {
        "after": {
          "bucket": "company-leaked-data",
          "acl": "public-read"
        }
      }
    },
    {
      "address": "aws_s3_bucket.public_rw_bucket",
      "type": "aws_s3_bucket",
      "change": {
        "after": {
          "bucket": "company-writable-data",
          "acl": "public-read-write"
        }
      }
    },
    {
      "address": "aws_security_group.safe_sg",
      "type": "aws_security_group",
      "change": {
        "after": {
          "ingress": [
            {
              "from_port": 22,
              "to_port": 22,
              "cidr_blocks": ["10.0.0.0/8"]
            }
          ]
        }
      }
    },
    {
      "address": "aws_security_group.open_ssh_sg",
      "type": "aws_security_group",
      "change": {
        "after": {
          "ingress": [
            {
              "from_port": 22,
              "to_port": 22,
              "cidr_blocks": ["0.0.0.0/0"]
            }
          ]
        }
      }
    },
    {
      "address": "aws_security_group.open_http_sg",
      "type": "aws_security_group",
      "change": {
        "after": {
          "ingress": [
            {
              "from_port": 80,
              "to_port": 80,
              "cidr_blocks": ["0.0.0.0/0"]
            }
          ]
        }
      }
    },
    {
      "address": "aws_security_group.wildcard_sg",
      "type": "aws_security_group",
      "change": {
        "after": {
          "ingress": [
            {
              "from_port": 0,
              "to_port": 65535,
              "cidr_blocks": ["0.0.0.0/0"]
            }
          ]
        }
      }
    }
  ]
}
